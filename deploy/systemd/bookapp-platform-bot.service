[Unit]
Description=BookApp platform administration bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=platform-bot
Group=platform-bot
Environment=BOOKAPP_MANAGED_PLATFORM_BOT=1
EnvironmentFile=/etc/bookapp/platform-bot.env
WorkingDirectory=/opt/bookapp/releases/current
ExecStart=/opt/bookapp/releases/current/.venv/bin/python -m controlplane.bot
LoadCredential=platform_bot_token:/etc/bookapp/platform-bot-token
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
