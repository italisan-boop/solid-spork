# Токен Telegram бота (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# URL веб-приложения (например, ngrok или ваш домен)
WEBAPP_URL=https://example.com

# Режим запуска: polling или webhook
RUN_MODE=polling

# ID администраторов (через запятую, без пробелов)
ADMIN_IDS=123456789,987654321

# Путь к базе данных
DATABASE_PATH=bot_database.db

# Настройки сервера
HOST=0.0.0.0
PORT=8000

# Платежный токен (если используется Яндекс.Касса или другая система)
PAYMENT_TOKEN=your_payment_token_here

# Секретный ключ для подписей
SECRET_KEY=your_secret_key_here
